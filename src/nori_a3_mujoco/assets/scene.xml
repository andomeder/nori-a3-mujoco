<!-- Demo scene for the Nori A3 MuJoCo model: floor, a table and a cube. -->
<mujoco model="nori_a3_scene">
  <include file="a3.xml"/>

  <statistic center="0.2 0 0.7" extent="1.6"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="150" elevation="-20" offwidth="1280" offheight="720"/>
    <quality shadowsize="2048"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.55 0.65 0.75" rgb2="0.05 0.06 0.08" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.24 0.26 0.29" rgb2="0.18 0.2 0.22" markrgb="0.5 0.5 0.5" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="4 4" reflectance="0.15"/>
    <material name="table" rgba="0.62 0.5 0.38 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true" castshadow="true"/>
    <light pos="2 -2 3" dir="-0.5 0.5 -1" diffuse="0.4 0.4 0.4" castshadow="false"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" contype="1" conaffinity="2" friction="1 0.01 0.001"/>

    <body name="table" pos="1.25 0 0">
      <geom name="table_top" type="box" size="0.3 0.4 0.02" pos="0 0 0.74" material="table" contype="1" conaffinity="3"/>
      <geom type="box" size="0.02 0.02 0.36" pos="0.26 0.36 0.36" material="table" contype="1" conaffinity="3"/>
      <geom type="box" size="0.02 0.02 0.36" pos="-0.26 0.36 0.36" material="table" contype="1" conaffinity="3"/>
      <geom type="box" size="0.02 0.02 0.36" pos="0.26 -0.36 0.36" material="table" contype="1" conaffinity="3"/>
      <geom type="box" size="0.02 0.02 0.36" pos="-0.26 -0.36 0.36" material="table" contype="1" conaffinity="3"/>
    </body>
    <body name="cube" pos="1.0 0.12 0.785">
      <freejoint name="cube_free"/>
      <geom name="cube" type="box" size="0.025 0.025 0.025" rgba="0.85 0.2 0.15 1" mass="0.08" contype="3" conaffinity="3" friction="1.2 0.01 0.001"/>
    </body>

    <camera name="demo_wide" pos="2.4 -1.9 1.6" xyaxes="0.62 0.78 0 -0.3 0.24 0.92" fovy="45"/>
  </worldbody>
</mujoco>
