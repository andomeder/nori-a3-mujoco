# Copied to .env by `make setup`; the Makefile exports it.
# Offscreen rendering backend: egl (GPU, headless), osmesa (pure software), glfw (needs a display).
MUJOCO_GL=egl
# Torch device for policy inference: auto (cuda -> xpu -> cpu), xpu, xpu:0, cuda, cpu.
NORI_DEVICE=auto
# 1 = run ipex.optimize() on XPU models if intel-extension-for-pytorch is installed (optional).
NORI_IPEX=0
# 1 = attach MuJoCo's interactive viewer to every mujoco_session (needs a display).
NORI_VIEWER=0
# Level Zero: show only the discrete Arc card if the iGPU is also visible (uncomment and adjust).
# ONEAPI_DEVICE_SELECTOR=level_zero:0
